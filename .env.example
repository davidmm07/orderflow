# Orderflow configuration template.
#
# Copy this file to .env for local runs, or run `make env` to do it with a
# freshly generated secret. .env is git-ignored and must never be committed.
# In deployed environments, inject these variables from a secret manager.

# Address to listen on. Keep 127.0.0.1 unless the port must be reachable
# from other hosts (the container image sets 0.0.0.0 itself).
ORDERFLOW_BIND_ADDR=127.0.0.1:8080

# json for log pipelines, pretty for humans.
ORDERFLOW_LOG_FORMAT=pretty
RUST_LOG=info

# Assets and markets to list. Adding an instrument is an edit to this file.
ORDERFLOW_INSTRUMENTS_FILE=config/instruments.json

# Comma separated key_id:account_id:secret triples. Secrets need at least
# 32 characters. Generate one with: openssl rand -hex 32
ORDERFLOW_API_CREDENTIALS=

# HTTP limits.
ORDERFLOW_REQUEST_TIMEOUT_MS=5000
ORDERFLOW_MAX_BODY_BYTES=16384
ORDERFLOW_SIGNATURE_TOLERANCE_SECS=30
ORDERFLOW_RATE_LIMIT_PER_SEC=50
ORDERFLOW_RATE_LIMIT_BURST=100

# Runtime capacities. Full queues answer 503 instead of growing.
ORDERFLOW_ENGINE_QUEUE_CAPACITY=4096
ORDERFLOW_OUTBOX_CAPACITY=8192
ORDERFLOW_IDEMPOTENCY_TTL_SECS=86400
ORDERFLOW_IDEMPOTENCY_MAX_ENTRIES=1000000
ORDERFLOW_SHUTDOWN_GRACE_SECS=10

# Event sink: log, or kafka (needs a build with --features kafka).
ORDERFLOW_EVENT_SINK=log
# ORDERFLOW_KAFKA_BROKERS=127.0.0.1:19092
# ORDERFLOW_KAFKA_TOPIC=orderflow.events.v1

# ---------------------------------------------------------------------------
# Price feed (crates/pricefeed). Run with: make run-pricefeed
# ---------------------------------------------------------------------------

PRICEFEED_BIND_ADDR=127.0.0.1:8090
PRICEFEED_LOG_FORMAT=pretty

# all: ingest and serve in one process. ingest / edge: split deployment
# connected through Redis (see docs/adr/0008).
PRICEFEED_ROLE=all
PRICEFEED_FEEDS_FILE=config/marketdata.json

# Optional locally: without them history is kept in memory. Both URLs can
# hold credentials, so they live here and never in a committed file.
# PRICEFEED_DATABASE_URL=postgres://pricefeed:<password>@127.0.0.1:5432/pricefeed
# PRICEFEED_REDIS_URL=redis://127.0.0.1:6379

# Chain RPC endpoints. Public ones work out of the box; for production use a
# provider URL, which usually carries an API key in its path.
# PRICEFEED_EVM_RPC_URL=https://ethereum-rpc.publicnode.com
# PRICEFEED_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# PRICEFEED_COINGECKO_API_KEY=

# Sources to run (comma separated), all configured ones when unset:
# coingecko, kraken, coinbase, uniswap_v3, orca, orderflow. "none" runs none.
# PRICEFEED_SOURCES=kraken,coinbase

# Orderflow's own trades (needs a build with --features kafka).
# PRICEFEED_KAFKA_BROKERS=127.0.0.1:19092

# Password of the compose Postgres. Created by `make env`, or added to an
# existing .env by `make pricefeed-env`.
PRICEFEED_DB_PASSWORD=
