# Build output
/target/

# Environment files hold secrets and must never be committed.
# Only the placeholder template is tracked.
.env
.env.*
!.env.example

# Key material
*.pem
*.key
*.p12
secrets/

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store

# Postman environments generated from .env contain secrets
postman/environments/*local.environment.yaml

# Postman writes each developer's own cloud workspace binding here
.postman/

# Terraform: provider caches, state (holds generated secrets) and variable
# files (may hold credentials). The lock file and the example are committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
